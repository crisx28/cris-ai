# ------------------------------------------------------------------
# Cris Budget OS — environment variables
# ------------------------------------------------------------------
# The app runs 100% WITHOUT any of these (it uses local demo data).
# Fill these in only when you're ready to save data to the cloud
# and enable login. See README.md → "Going live with Supabase".
# ------------------------------------------------------------------

# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL: enables real Claude-powered answers in the AI Assistant.
# Without it, the assistant still works using the built-in money engine.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CRIS_MODEL=claude-sonnet-5
